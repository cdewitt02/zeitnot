# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Zeitnot reads .env from the working directory on every run — there is nothing
# to source. A variable already exported wins over this file, so a value set by
# hand is never quietly overwritten. `zeitnot doctor` prints which file was read
# and which values it declined to set for that reason.
#
# Line endings, quoting, and the order these lines appear in are all handled:
# carriage returns are stripped, comments and quotes are parsed rather than
# word-split, and ${VAR} references resolve against the whole file. A leading
# `export` is still accepted, so an existing file — and `. ./.env`, if you would
# rather keep sourcing — both keep working.
#
# Point zeitnot at a file somewhere else with ZEITNOT_ENV_FILE, or set that to
# the empty string to read no file at all. It has to come from the environment,
# since it decides which file is read.

# The host port docker-compose.yml publishes. Change it here and DATABASE_URL
# below follows, because the two have to agree. docker compose reads this file
# too, so `docker compose up -d` picks it up without the variable being
# exported on the command line — and `zeitnot doctor` compares the two.
ZEITNOT_DB_PORT=5432

# PostgreSQL connection string (required). The credentials are the ones
# docker-compose.yml sets; change them only if you brought your own PostgreSQL.
DATABASE_URL="postgres://zeitnot:zeitnot@localhost:${ZEITNOT_DB_PORT}/zeitnot?sslmode=disable"

# Required only when CHAT_PROVIDER=anthropic.
# Create one at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Required when CHAT_PROVIDER=openai or EMBED_PROVIDER=openai.
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Provider selection. Both default to ollama, which needs no account and no
# network. Chat and embeddings are chosen independently because Anthropic has
# no embeddings API.
# Setting both to openai is what removes Ollama from the prerequisite list.
# CHAT_PROVIDER=ollama     # ollama | anthropic | openai
# EMBED_PROVIDER=ollama    # ollama | openai

# Models. The positional CLI argument to `zeitnot chat` outranks CHAT_MODEL.
# CHAT_MODEL=              # default: llama3.2 / claude-opus-5 / gpt-5-2025-08-07
# EMBED_MODEL=             # default: nomic-embed-text / text-embedding-3-small
#                          # whichever model is chosen must emit 768 dimensions

# OLLAMA_URL=http://localhost:11434
# NUM_WORKERS=4

# Where the Stockfish binary is, if it is not on PATH. Usually easier than
# editing PATH, and it covers the apt install, which lands in /usr/games —
# on the PATH of a login shell but often not otherwise.
# STOCKFISH_PATH=/usr/games/stockfish
